@inject IConfiguration Configuration
@{
    var path = Context.Request.Path;
    bool paginaIdentity = path.StartsWithSegments("/Identity");

    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool paginaAdmin = controllerAtual == "Admin";
    bool paginaCheckout = controllerAtual == "Pagamento" || controllerAtual == "Vender" || paginaAdmin;
    bool paginaInformacoes = controllerAtual == "Informacoes";

    string tituloSite = ViewData["TituloSite"]?.ToString() ?? "DESAPEGUEI";
    string categoriaFiltro = ViewData["CategoriaFiltro"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Desapeguei</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
</head>

<body class="@(paginaCheckout ? "corpo-checkout" : "")">

    @if (!paginaIdentity && !paginaCheckout)
    {
        <!-- HEADER MARKETPLACE -->
        <header class="header-custom shadow">

            <div class="container-fluid">

                <!-- TOPO -->
                <div class="top-header py-2">

                    <!-- ESQUERDA -->
                    <div class="d-flex align-items-center gap-3">

                        <!-- LOGO -->
                        
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/img/logo.jpg" class="logo-site" alt="Desapeguei">
                        </a>
                        


                        <!-- PESQUISA -->
                        <div class="input-group barra-pesquisa">
                            <input type="text" class="form-control" placeholder="Pesquisar">
                            <button class="btn lupa">
                                <img src="~/img/lupa.png" alt="Lupa">
                            </button>
                        </div>

                    </div>

                    <!-- DIREITA -->
                    <div class="icones">

                        <!-- CARRINHO -->
                        <a asp-controller="Carrinho" asp-action="Index" class="btn carrinho-btn">
                            <img src="~/img/carrinho.png" class="carrinho">
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- PERFIL -->
                            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="perfil-btn">
                                <img src="~/img/avatar.png" class="logo-perfil">
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <!-- ACESSO AO PAINEL ADMIN -->
                                <a asp-controller="Admin" asp-action="Index" class="btn btn-admin-link">
                                    Painel Admin
                                </a>
                            }

                            <!-- BLOCO USUARIO -->
                            <div class="usuario-box">
                                <span class="email-usuario">
                                    @User.Identity?.Name?.Split('@')[0]
                                </span>

                                <form asp-area="Identity" asp-page="/Account/Logout"
                                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                      method="post">
                                    <button type="submit" class="btn btn-danger btn-sair">Sair</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light">Login</a>
                            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-warning">Registrar</a>
                        }

                    </div>

                </div>

                <!-- TITULO -->
                <h1 class="titulo-site">@tituloSite</h1>

                <!-- MENU -->
                <div class="menu-header d-flex justify-content-center flex-wrap pb-3">
                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Acessórios" class="nav-link-custom">Acessórios</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Brinquedos" class="nav-link-custom">Brinquedos</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Móveis" class="nav-link-custom">Móveis</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Roupas" class="nav-link-custom">Roupas</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Calçados" class="nav-link-custom">Calçados</a>
                </div>

                <!-- BOTAO -->
                <div class="d-flex justify-content-center pb-3">
                    <a asp-controller="Vender" asp-action="Index" class="btn vender-btn px-4">
                        Quero vender
                    </a>
                </div>

            </div>

        </header>
    }

    @if (paginaCheckout || paginaIdentity)
    {
        <!-- HEADER COMPACTO (PAGAMENTO / VENDER) -->
        <header class="header-checkout">
            <div class="container-fluid d-flex align-items-center justify-content-between py-2">

                <img src="~/img/logo.jpg" class="logo-checkout">

                <h1 class="titulo-checkout mb-0">@tituloSite</h1>

                @if (paginaIdentity || controllerAtual == "Vender" || paginaAdmin)
                {
                    <a asp-controller="Home" asp-action="Index" class="icone-checkout-link">
                        <img src="~/img/casa.png" class="icone-checkout">
                    </a>
                }
                else
                {
                    <div class="d-flex gap-3">
                        <a asp-controller="Pagamento" asp-action="Index" class="icone-checkout-link">
                            <img src="~/img/carrinho.png" class="icone-checkout">
                        </a>

                        <a asp-area="Identity" asp-page="/Account/Manage/Index" class="icone-checkout-link">
                            <img src="~/img/avatar.png" class="icone-checkout">
                        </a>
                    </div>
                }

            </div>
        </header>
    }

    <!-- CONTEUDO -->
    <main class="@(paginaCheckout ? "container-fluid px-0" : "container py-5") @(paginaIdentity ? "identity-main" : "")">
        @if (!paginaIdentity && !paginaCheckout && !paginaInformacoes)
        {
            <div class="row g-4" id="produtosContainer" data-categoria="@categoriaFiltro">
            </div>
        }

        @RenderBody()

</main>
        
    @if (!paginaAdmin && !paginaIdentity)
    {
        <footer class="footer-desapeguei">

            <div class="footer-conteudo">

                <div class="footer-coluna">
                    <h4>DESAPEGUEI</h4>
                    <p>Encontre, venda e desapegue.</p>
                </div>

                <div class="footer-coluna">
                    <h4>SHOP</h4>

                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Roupas">
                        Roupas
                    </a>

                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Calçados">
                        Calçados
                    </a>

                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Brinquedos">
                        Brinquedos
                    </a>

                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Móveis">
                        Móveis
                    </a>

                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="Acessórios">
                        Acessórios
                    </a>
                </div>

                <div class="footer-coluna">
                    <h4>AJUDA</h4>

                    <a asp-controller="Informacoes" asp-action="Contato">Contato</a>
                    <a asp-controller="Informacoes" asp-action="PerguntasFrequentes">Perguntas frequentes</a>
                    <a asp-controller="Informacoes" asp-action="ComoVender">Como vender</a>
                    <a asp-controller="Informacoes" asp-action="ComoComprar">Como comprar</a>
                </div>

                <div class="footer-coluna">
                    <h4>SOBRE</h4>

                    <a asp-controller="Informacoes" asp-action="QuemSomos">Quem somos</a>
                    <a asp-controller="Informacoes" asp-action="NossaHistoria">Nossa história</a>
                    <a asp-controller="Informacoes" asp-action="TermosServico">Termos de Serviço</a>
                    <a asp-controller="Informacoes" asp-action="Privacidade">Privacidade</a>
                </div>

            </div>

            <div class="footer-final">
                © 2026 Desapeguei. Todos os direitos reservados.
            </div>

        </footer>
    }
     

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Endereço da Desapeguei.Api, usado pelo home.js e vender.js -->
    <script>
        const API_BASE = "@((Configuration["ApiBaseUrl"] ?? "").TrimEnd('/'))";
    </script>

    <script src="~/js/home.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)


    
</body>
</html>
