@{
    ViewData["Title"] = "Perguntas Frequentes";
    ViewData["TituloSite"] = "PERGUNTAS FREQUENTES";
}

<div class="pagina-informacao">

    <h2>Perguntas Frequentes</h2>

    <h4>Como faço para comprar um produto?</h4>
    <p>
        Escolha o produto que deseja, confira as informações e siga para a etapa de pagamento.
    </p>

    <h4>Como faço para vender um produto?</h4>
    <p>
        Clique em "Quero vender" no menu do site e preencha as informações do produto.
    </p>

    <h4>Preciso criar uma conta para comprar?</h4>
    <p>
        Sim. A conta permite que seus dados sejam identificados durante o processo de compra.
    </p>

    <h4>Posso cancelar uma compra?</h4>
    <p>
        Para solicitar o cancelamento, entre em contato com nossa equipe de atendimento.
    </p>

    <h4>Como entro em contato com o Desapeguei?</h4>
    <p>
        Acesse a página "Contato" no rodapé para encontrar nossos canais de atendimento.
    </p>

    <a asp-controller="Home" asp-action="Index" class="btn voltar-btn">
        Voltar para a página inicial
    </a>

</div>