@{
    ViewData["Title"] = "Como comprar";
    ViewData["TituloSite"] = "COMO COMPRAR";
}

<div class="pagina-informacao">

    <h2>Como comprar no Desapeguei?</h2>

    <p>Comprar no Desapeguei é simples e rápido!</p>

    <h4>1. Escolha um produto</h4>
    <p>
        Navegue pelas categorias e escolha o produto que deseja comprar.
    </p>

    <h4>2. Confira as informações</h4>
    <p>
        Verifique o nome, a descrição e o preço do produto antes de realizar a compra.
    </p>

    <h4>3. Adicione ao carrinho</h4>
    <p>
        Adicione o produto ao seu carrinho para continuar a compra.
    </p>

    <h4>4. Realize o pagamento</h4>
    <p>
        Acesse o carrinho e siga as etapas para finalizar o pagamento.
    </p>

    <h4>5. Pronto!</h4>
    <p>
        Depois de finalizar a compra, basta aguardar as próximas informações sobre o pedido.
    </p>

    <a asp-controller="Home" asp-action="Index" class="btn voltar-btn">
        Voltar para a página inicial
    </a>

</div>