@{
    ViewData["Title"] = "Quero Vender";
}

<div class="vender-container">

    <form id="formVenderProduto" enctype="multipart/form-data">

        <input type="text"
               class="form-control titulo-produto-input"
               id="tituloProduto"
               name="Titulo"
               placeholder="Título do anúncio (ex: Mesa Gamer usada)"
               required>

        <div class="row g-3">

            <!-- ADICIONAR IMAGEM -->
            <div class="col-6 col-md-3">
                <label class="upload-box mb-0" for="inputImagem">
                    <img src="~/img/barras.png" class="icone-upload" id="iconeImagem">
                    <span id="textoImagem">Adicionar imagem</span>
                </label>
                <input type="file" id="inputImagem" name="Imagem" accept="image/*" class="d-none">
            </div>

            <!-- ADICIONAR VIDEO (ilustrativo) -->
            <!-- ADICIONAR VIDEO (ilustrativo) -->
            <!-- ADICIONAR VIDEO -->
            <div class="col-6 col-md-3">
                <label class="upload-box mb-0" for="inputVideo">

                    <img src="~/img/avatar.png"
                         class="icone-upload"
                         id="iconeVideo">

                    <span id="textoVideo">Adicionar vídeo</span>

                </label>

                <input type="file"
                       id="inputVideo"
                       name="Video"
                       accept="video/*"
                       class="d-none">

                <!-- Pré-visualização do vídeo -->
                <video id="previewVideo"
                       controls
                       style="display:none; width:100%; margin-top:10px; border-radius:10px;">
                </video>
            </div>

            <!-- DESCRICAO -->
            <div class="col-12 col-md-6">
                <textarea class="form-control descricao-produto"
                          id="descricaoProduto"
                          name="Descricao"
                          placeholder="Escreva a descrição do seu produto aqui..."
                          required></textarea>
            </div>

        </div>

        <div class="row">
            <div class="col-12 col-md-6">
                <!-- CATEGORIAS -->
                <div class="categoria-box">
                    <strong class="d-block mb-2">Selecionar categoria</strong>

                    <div class="form-check">
                        <input class="form-check-input categoria-radio" type="radio" name="Categoria" value="Roupas" id="catRoupas">
                        <label class="form-check-label" for="catRoupas">Roupas</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input categoria-radio" type="radio" name="Categoria" value="Calçados" id="catCalcados">
                        <label class="form-check-label" for="catCalcados">Calçados</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input categoria-radio" type="radio" name="Categoria" value="Brinquedos" id="catBrinquedos">
                        <label class="form-check-label" for="catBrinquedos">Brinquedos</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input categoria-radio" type="radio" name="Categoria" value="Acessórios" id="catAcessorios">
                        <label class="form-check-label" for="catAcessorios">Acessórios</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input categoria-radio" type="radio" name="Categoria" value="Móveis" id="catMoveis">
                        <label class="form-check-label" for="catMoveis">Móveis</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input categoria-radio" type="radio" name="Categoria" value="Outros" id="catOutros">
                        <label class="form-check-label" for="catOutros">Outros</label>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="preco-publicar">
                    <input type="text"
                           class="form-control input-preco"
                           id="precoProduto"
                           name="Preco"
                           placeholder="R$ 00,00"
                           required>

                    <button type="submit" class="btn-publicar">PUBLICAR</button>
                </div>
            </div>

        </div>

    </form>

    <div class="mensagem-vender" id="mensagemVender"></div>

</div>

@section Scripts {
    <script src="~/js/vender.js" asp-append-version="true"></script>
}
