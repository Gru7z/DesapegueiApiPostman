@model Desapeguei.Web.Models.Produto
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Editar Produto";
    var apiBaseUrl = (Configuration["ApiBaseUrl"] ?? "").TrimEnd('/');
    var imagemAtual = string.IsNullOrEmpty(Model.ImagemUrl) ? "/img/produto1.jpg" : $"{apiBaseUrl}{Model.ImagemUrl}";
}

<div class="admin-editar-container">

    <a asp-controller="Admin" asp-action="Index" class="link-voltar-admin">&larr; Voltar para o painel</a>

    <h2 class="admin-titulo mb-4">Editar produto</h2>

    <form asp-controller="Admin" asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-editar-admin">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImagemUrl" />
        <input type="hidden" asp-for="CriadoPor" />
        <input type="hidden" asp-for="DataCriacao" />

        <div class="row g-4">

            <div class="col-12 col-md-4">
                <label class="form-label-admin">Imagem atual</label>
                <div class="preview-imagem-admin">
                    <img src="@imagemAtual" alt="@Model.Titulo">
                </div>

                <label class="form-label-admin mt-3">Trocar imagem (opcional)</label>
                <input type="file" name="novaImagem" accept="image/*" class="form-control">
            </div>

            <div class="col-12 col-md-8">

                <label class="form-label-admin">Título</label>
                <input asp-for="Titulo" class="form-control campo-admin" />
                <span asp-validation-for="Titulo" class="text-danger"></span>

                <label class="form-label-admin mt-3">Descrição</label>
                <textarea asp-for="Descricao" class="form-control campo-admin campo-admin-textarea"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>

                <div class="row g-3 mt-1">
                    <div class="col-6">
                        <label class="form-label-admin">Categoria</label>
                        <select asp-for="Categoria" class="form-select campo-admin">
                            <option value="Roupas">Roupas</option>
                            <option value="Calçados">Calçados</option>
                            <option value="Brinquedos">Brinquedos</option>
                            <option value="Acessórios">Acessórios</option>
                            <option value="Móveis">Móveis</option>
                            <option value="Outros">Outros</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label-admin">Preço (R$)</label>
                        <input asp-for="Preco" class="form-control campo-admin" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Preco" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" asp-for="Disponivel" role="switch" id="switchDisponivel">
                    <label class="form-check-label label-disponivel-admin" for="switchDisponivel">
                        Produto visível no site
                    </label>
                </div>

                <div class="acoes-editar-admin">
                    <a asp-controller="Admin" asp-action="Index" class="btn-admin btn-cancelar-editar-admin">Cancelar</a>
                    <button type="submit" class="btn-admin btn-salvar-admin">Salvar alterações</button>
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
