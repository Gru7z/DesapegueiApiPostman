@model List<Desapeguei.Web.Models.Produto>

@{
    ViewData["Title"] = "Página inicial";
    var apiBaseUrl = (ViewData["ApiBaseUrl"]?.ToString() ?? "")
        .TrimEnd('/');
}

<div class="container py-4">
    <h1 class="mb-4">
        @ViewData["TituloSite"]
    </h1>

    @if (Model == null || !Model.Any())
    {
        <p>Nenhum produto disponível no momento.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var produto in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))
                        {
                            var imagemUrl = produto.ImagemUrl;

                            if (Uri.TryCreate(
                                imagemUrl,
                                UriKind.Absolute,
                                out var imagemAbsoluta))
                            {
                                imagemUrl = imagemAbsoluta.ToString();
                            }
                            else
                            {
                                imagemUrl = $"{apiBaseUrl}/{imagemUrl.TrimStart('/')}";
                            }

                            <img src="@imagemUrl"
                                 class="card-img-top"
                                 alt="@produto.Titulo"
                                 style="height: 220px; object-fit: cover;" />
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                @produto.Titulo
                            </h5>

                            <p class="text-muted mb-2">
                                @produto.Categoria
                            </p>

                            <p class="card-text">
                                @produto.Descricao
                            </p>

                            <h4 class="mt-auto text-success">
                                @produto.Preco.ToString("C")
                            </h4>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
